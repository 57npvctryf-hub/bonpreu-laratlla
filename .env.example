# Mistral API key (created in Mistral Studio -> API keys)
MISTRAL_API_KEY=

# BonpreuEsclat credentials (same as the BonpreuEsclat app / www.bonpreuesclat.cat login).
# Never commit these. Copy this file to .env and fill it in locally, or bind them as
# Studio secrets when deploying.
BONPREU_EMAIL=
BONPREU_PASSWORD=

# Optional overrides:
# BONPREU_BASE_URL=https://energia.bonpreuesclat.cat
# BONPREU_INVOICES_PATH=/factures
# BONPREU_SESSION_FILE=.bonpreu-session.json
# BONPREU_INVOICES_DIR=invoices
